# Required
BOT_TOKEN=
ADMIN_ID=
WEBAPP_URL=https://your-service.example.com

# Persistent database (recommended)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# AI translation (recommended for the selected AI mode)
# Keep this key private; never put it in public/index.html or commit a real key.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Optional sources and publishing destinations
TARGET_CHANNELS=
X_FEED_URL=
NITTER_HOSTS=

# Optional legacy translation fallback
LIBRETRANSLATE_URL=
LIBRETRANSLATE_KEY=

# Runtime tuning
MAX_AGE_HOURS=12
MAX_PER_CYCLE=5
FETCH_INTERVAL_MS=300000
POST_DELAY_MS=5000
PRICE_THRESHOLD_PCT=3
AD_FILTER=1
